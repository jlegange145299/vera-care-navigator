{
  "name": "vera-care-navigator",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/mobile"
  ],
  "type": "module",
  "description": "Vera — a conversational healthcare value navigator and friction intelligence proof of concept.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "npm run build:core && concurrently --kill-others-on-fail \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:core && npm run build:client && npm run build:server",
    "build:core": "npm run build -w @vera/core",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest --run --config vitest.config.ts && vitest --run --config vitest.server.config.ts",
    "test:client": "vitest --run --config vitest.config.ts",
    "test:server": "vitest --run --config vitest.server.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "dev:mobile": "npm run start -w vera-mobile",
    "build:mobile": "npm run build:core && npm run export:web -w vera-mobile",
    "postinstall": "node scripts/link-mobile-expo.mjs"
  },
  "dependencies": {
    "@vera/core": "0.1.0",
    "cors": "2.8.5",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "lucide-react": "1.46.0",
    "openai": "7.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "@heygen/liveavatar-web-sdk": "0.0.19",
    "concurrently": "10.0.5",
    "jsdom": "29.1.1",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
