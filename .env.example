# The app is fully usable without credentials in deterministic demo mode.
PORT=8787
DEMO_MODE=true

# OpenAI Responses API (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional LiveAvatar short-lived embed integration (server-side only)
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_BASE_URL=https://api.liveavatar.com

# Comma-separated browser origins allowed to call /api/chat (mobile web on Render, local Expo web).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Mobile app (Expo) — desktop/API base URL for Render mobile web and local Expo web.
EXPO_PUBLIC_VERA_API_URL=http://localhost:8787
LIVEAVATAR_CONTEXT_ID=
LIVEAVATAR_EMBED_ENDPOINT=https://api.liveavatar.com/v2/embeddings
LIVEAVATAR_ALLOWED_HOSTS=liveavatar.com,heygen.com
